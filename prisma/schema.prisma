// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  order     Int        @default(0)
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id           String            @id @default(cuid())
  name         String
  description  String?
  price        Int
  imageUrl     String?
  isAvailable  Boolean           @default(true)
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  optionGroups MenuOptionGroup[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([categoryId])
}

/// A question the customer answers before ordering an item, e.g. "Ukuran" or
/// "Topping". Belongs to one menu item so the owner can price a large latte
/// differently from a large tea.
model MenuOptionGroup {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  /// The item cannot be added to the cart until at least one choice is made.
  isRequired Boolean  @default(false)
  /// 1 = pick one, more = pick up to this many.
  maxSelect  Int      @default(1)
  order      Int      @default(0)

  options   MenuOption[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([menuItemId])
}

model MenuOption {
  id      String          @id @default(cuid())
  groupId String
  group   MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name    String
  /// Added to the item's base price. 0 for choices that cost nothing.
  priceDelta  Int     @default(0)
  isAvailable Boolean @default(true)
  order       Int     @default(0)

  orderItemOptions OrderItemOption[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([groupId])
}

enum OrderStatus {
  DITERIMA
  DIPROSES
  SELESAI
}

enum PaymentMethod {
  QRIS
  VIRTUAL_ACCOUNT
}

enum PaymentStatus {
  BELUM_BAYAR
  SUDAH_BAYAR
}

model Table {
  id       Int     @id
  /// Unguessable token embedded in the table's QR code. The customer URL uses
  /// this, never the table number, so nobody can reach another table's order
  /// flow by editing the URL — a wrong table number breaks trust in the system.
  qrToken  String  @unique @default(cuid())
  isActive Boolean @default(true)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  /// Resets daily; shown to the customer and called out by the barista.
  queueNumber   Int
  id            String        @id @default(cuid())
  tableId       Int
  table         Table         @relation(fields: [tableId], references: [id])
  status        OrderStatus   @default(DITERIMA)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(BELUM_BAYAR)
  /// Denormalized sum of items in rupiah, so reports don't have to re-add
  /// snapshots and historical totals stay stable.
  totalAmount   Int
  note          String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([tableId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  /// Name and price are copied at order time so past orders and sales reports
  /// stay correct even after the menu item is renamed, repriced, or deleted.
  nameSnapshot  String
  priceSnapshot Int

  quantity Int
  note     String?

  options OrderItemOption[]

  @@index([orderId])
  @@index([menuItemId])
}

/// One choice the customer made for an order line, e.g. Ukuran = Large.
model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  menuOptionId String
  menuOption   MenuOption @relation(fields: [menuOptionId], references: [id])
  /// Snapshotted for the same reason as OrderItem: the barista's ticket and old
  /// sales reports must survive the owner renaming or repricing a choice.
  groupNameSnapshot  String
  nameSnapshot       String
  priceDeltaSnapshot Int

  @@index([orderItemId])
  @@index([menuOptionId])
}
