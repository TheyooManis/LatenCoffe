// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  order     Int        @default(0)
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
  isAvailable Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

enum OrderStatus {
  DITERIMA
  DIPROSES
  SELESAI
}

enum PaymentMethod {
  QRIS
  VIRTUAL_ACCOUNT
}

enum PaymentStatus {
  BELUM_BAYAR
  SUDAH_BAYAR
}

model Table {
  id       Int     @id
  /// Unguessable token embedded in the table's QR code. The customer URL uses
  /// this, never the table number, so nobody can reach another table's order
  /// flow by editing the URL — a wrong table number breaks trust in the system.
  qrToken  String  @unique @default(cuid())
  isActive Boolean @default(true)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  /// Resets daily; shown to the customer and called out by the barista.
  queueNumber   Int
  id            String        @id @default(cuid())
  tableId       Int
  table         Table         @relation(fields: [tableId], references: [id])
  status        OrderStatus   @default(DITERIMA)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(BELUM_BAYAR)
  /// Denormalized sum of items in rupiah, so reports don't have to re-add
  /// snapshots and historical totals stay stable.
  totalAmount   Int
  note          String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([tableId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  /// Name and price are copied at order time so past orders and sales reports
  /// stay correct even after the menu item is renamed, repriced, or deleted.
  nameSnapshot  String
  priceSnapshot Int

  quantity Int
  note     String?

  @@index([orderId])
  @@index([menuItemId])
}
